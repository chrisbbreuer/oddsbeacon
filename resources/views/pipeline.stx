<script server>
/**
 * PredictHQ: pipeline health.
 *
 * The page that answers whether anything else on this site can be
 * trusted right now. Two facts carry it: where the prices came from, and
 * whether the model has ever been scored against a result.
 *
 * Both were already knowable from `/api/v1/status` and
 * `/api/v1/calibration` and neither was on any page, so a visitor reading
 * a 6% edge off the board had no way to learn it came from a simulator
 * and that nothing had ever been checked against an outcome.
 */
import { isMeaningful, loadFeedState, loadFundamentalsCoverage, loadProviderRuns, loadTrackRecord, LIVE_FEED_ENV, MIN_MEANINGFUL_SAMPLES, relativeAge, scoreSignals } from '../../app/Support/pipeline'

const navActive = 'pipeline'
const pageTitle = 'PredictHQ: pipeline health'
const pageDescription = 'Where the prices come from, when they last updated, and how the model has scored against settled results.'

const feed = await loadFeedState()
const runs = await loadProviderRuns()
const record = await loadTrackRecord()
const coverage = await loadFundamentalsCoverage()
const signals = await scoreSignals()
const coveragePct = coverage.teamsTotal > 0
  ? Math.round((coverage.teamsWithStanding / coverage.teamsTotal) * 100)
  : 0

function when(timestamp) {
  if (!timestamp)
    return 'not yet'

  return new Date(timestamp).toLocaleString('en-US', {
    month: 'short',
    day: 'numeric',
    hour: 'numeric',
    minute: '2-digit',
  })
}

// A Brier score is only meaningful next to the baseline it beat. 0.25 is
// what you get by answering 50% to everything, so it is the line a model
// has to be under to have done anything at all.
const COIN_FLIP_BRIER = 0.25
const beatsCoinFlip = record.sampleSize > 0 && record.brierScore < COIN_FLIP_BRIER
</script>

<!DOCTYPE html>
<html lang="en">
  <head>
    @include('head')
  </head>

  <body x-data="{ menu: false,
      theme: predicthqTheme.current(), toggleTheme() { this.theme = predicthqTheme.toggle() }, toggleMenu() { this.menu = !this.menu } }">
    <div class="app">
      @include('nav')

      <main class="mx-auto px-4 py-14 sm:px-6 max-w-5xl">
        <h1 class="display font-black text-3xl tracking-tight sm:text-4xl">Pipeline</h1>
        <p class="mt-3 max-w-2xl leading-relaxed text-lg muted">
          Where the numbers come from, and what they have been worth so far.
        </p>

        {{--
          The loudest thing on the page, because it is the one fact that
          changes what every other number means.
        --}}
        <section class="p-6 mt-9 rounded-2xl card sm:p-7 {{ feed.live ? '' : 'sim-card' }}">
          <div class="flex flex-wrap gap-4 items-start justify-between">
            <div class="min-w-0">
              <div class="flex gap-2.5 items-center">
                <span class="h-2.5 w-2.5 rounded-full" style="background:{{ feed.live ? 'var(--pos)' : 'var(--neg)' }}" aria-hidden="true"></span>
                <h2 class="font-black text-xl">{{ feed.live ? 'Live prices' : 'Simulated prices' }}</h2>
              </div>
              @if (feed.live)
                <p class="mt-2 max-w-xl leading-relaxed muted">
                  Prices are coming from <span class="font-bold">{{ feed.provider }}</span>, last updated {{ relativeAge(feed.lastRunAt) }}.
                </p>
              @else
                <p class="mt-2 max-w-xl leading-relaxed muted">
                  Every price on this site is generated by the built-in simulator over real fixtures. The board looks live and is not. Any edge it reports is a property of the simulator, not of a market.
                </p>
                <p class="mt-3 text-sm faint">
                  Set <code class="px-1.5 py-0.5 rounded num soft">{{ LIVE_FEED_ENV }}</code> in your environment and the next run switches to the real feed on its own.
                </p>
              @endif
            </div>

            <div class="text-right shrink-0">
              <div class="font-black text-2xl num">{{ relativeAge(feed.lastRunAt) }}</div>
              <div class="mt-0.5 font-semibold text-xs tracking-wide uppercase muted">Last price run</div>
            </div>
          </div>
        </section>

        <!-- track record -->
        <section class="mt-9">
          <h2 class="display font-black text-2xl tracking-tight">Track record</h2>

          @if (record.sampleSize)
            <p class="mt-2 max-w-2xl leading-relaxed muted">
              Scored over {{ record.sampleSize.toLocaleString() }} settled predictions, rebuilt {{ relativeAge(record.computedAt) }}.
            </p>
            <div class="grid gap-3 grid-cols-2 mt-6 sm:grid-cols-4">
              <div class="p-4 rounded-2xl card">
                <div class="font-black text-2xl num {{ beatsCoinFlip ? 'pos' : 'neg' }}">{{ record.brierScore.toFixed(4) }}</div>
                <div class="mt-0.5 font-semibold text-xs tracking-wide uppercase muted">Brier score</div>
                <div class="mt-1 text-xs faint">Coin flip is {{ COIN_FLIP_BRIER }}. Lower is better.</div>
              </div>
              <div class="p-4 rounded-2xl card">
                <div class="font-black text-2xl num">{{ record.logLoss.toFixed(4) }}</div>
                <div class="mt-0.5 font-semibold text-xs tracking-wide uppercase muted">Log loss</div>
                <div class="mt-1 text-xs faint">Punishes confident misses.</div>
              </div>
              <div class="p-4 rounded-2xl card">
                <div class="font-black text-2xl num {{ record.avgClvPct > 0 ? 'pos' : 'neg' }}">{{ record.avgClvPct.toFixed(2) }}%</div>
                <div class="mt-0.5 font-semibold text-xs tracking-wide uppercase muted">Avg CLV</div>
                <div class="mt-1 text-xs faint">Beat the closing line, or did not.</div>
              </div>
              <div class="p-4 rounded-2xl card">
                <div class="font-black text-2xl num">{{ record.sampleSize.toLocaleString() }}</div>
                <div class="mt-0.5 font-semibold text-xs tracking-wide uppercase muted">Settled</div>
                <div class="mt-1 text-xs faint">Predictions with an answer.</div>
              </div>
            </div>
          @else
            {{--
              An empty track record is the normal state of a new install,
              and it is very different from a bad one. Say which, and say
              when it stops being empty.
            --}}
            <div class="p-7 mt-6 rounded-2xl card">
              <p class="font-bold text-lg">Nothing has settled yet.</p>
              <p class="mt-2 max-w-2xl leading-relaxed muted">
                The model has priced {{ record.pendingPredictions.toLocaleString() }} {{ record.pendingPredictions === 1 ? 'event' : 'events' }} that have not finished. Until one does there is no Brier score, no CLV, and no basis for believing any edge on this site.
              </p>
              @if (record.nextSettlementAt)
                <p class="mt-4 text-sm">
                  <span class="font-semibold muted">First result expected</span>
                  <span class="ml-2 font-bold num">{{ when(record.nextSettlementAt) }}</span>
                </p>
              @endif
            </div>
          @endif
        </section>

        {{--
          Coverage, not volume. A thousand injury rows across two leagues
          still leaves every other fixture priced on book quotes alone,
          and the honest number is what fraction of teams the model can
          say anything independent about.
        --}}
        <section class="mt-12">
          <h2 class="display font-black text-2xl tracking-tight">Independent evidence</h2>
          <p class="mt-2 max-w-2xl leading-relaxed muted">
            Everything else here is derived from bookmaker prices, so it can only ever agree with them. These are the reads that can disagree.
          </p>

          <div class="grid gap-3 grid-cols-2 mt-6 sm:grid-cols-4">
            <div class="p-4 rounded-2xl card">
              <div class="font-black text-2xl num {{ coveragePct > 0 ? 'pos' : '' }}">{{ coveragePct }}%</div>
              <div class="mt-0.5 font-semibold text-xs tracking-wide uppercase muted">Teams with form</div>
              <div class="mt-1 text-xs faint">{{ coverage.teamsWithStanding.toLocaleString() }} of {{ coverage.teamsTotal.toLocaleString() }}</div>
            </div>
            <div class="p-4 rounded-2xl card">
              <div class="font-black text-2xl num">{{ coverage.injuriesTracked.toLocaleString() }}</div>
              <div class="mt-0.5 font-semibold text-xs tracking-wide uppercase muted">Teams with availability</div>
              <div class="mt-1 text-xs faint">Who is out, and how badly.</div>
            </div>
            <div class="p-4 rounded-2xl card">
              <div class="font-black text-2xl num {{ coverage.clubsValued ? '' : 'muted' }}">{{ coverage.clubsValued.toLocaleString() }}</div>
              <div class="mt-0.5 font-semibold text-xs tracking-wide uppercase muted">Clubs valued</div>
              <div class="mt-1 text-xs faint">{{ coverage.clubsValued ? 'Squad value and tier from retained Transfermarkt DOM snapshots.' : 'Transfermarkt DOM backfill has not completed yet.' }}</div>
            </div>
            <div class="p-4 rounded-2xl card">
              <div class="font-black text-2xl num">{{ relativeAge(coverage.lastCapturedAt) }}</div>
              <div class="mt-0.5 font-semibold text-xs tracking-wide uppercase muted">Last captured</div>
              <div class="mt-1 text-xs faint">Appended, never overwritten.</div>
            </div>
          </div>
        </section>

        {{--
          Which signals earned their weight. Every number the model uses
          to combine them is an assertion until this table has rows, so
          it is shown even when empty: an unscored signal is not a
          neutral one, it is one nobody has checked.
        --}}
        <section class="mt-12">
          <h2 class="display font-black text-2xl tracking-tight">Signal scorecard</h2>
          <p class="mt-2 max-w-2xl leading-relaxed muted">
            Each signal against the closing line. Beating the close is the fastest evidence that an estimate carried real information, long before a win rate says anything.
          </p>

          @if (signals.length)
            <div class="overflow-hidden mt-6 rounded-2xl card">
              <div class="divide-y bd">
                @foreach (signals as signal)
                  <div class="flex flex-col gap-2 items-start justify-between sm:flex-row sm:items-center px-5 py-4 sm:px-6">
                    <div class="min-w-0">
                      <div class="font-bold">{{ signal.kind }}</div>
                      <div class="mt-0.5 text-xs faint">
                        {{ isMeaningful(signal) ? `${signal.samples} scored decisions` : `${signal.samples} so far, too few to read` }}
                      </div>
                    </div>
                    <div class="flex gap-6 items-center shrink-0">
                      <div class="text-right">
                        <div class="font-bold text-sm num {{ isMeaningful(signal) ? (signal.avgClvPoints > 0 ? 'pos' : 'neg') : 'muted' }}">{{ signal.avgClvPoints.toFixed(2) }}</div>
                        <div class="text-xs faint">avg CLV pts</div>
                      </div>
                      <div class="text-right">
                        <div class="font-bold text-sm num {{ isMeaningful(signal) ? '' : 'muted' }}">{{ (signal.hitRate * 100).toFixed(0) }}%</div>
                        <div class="text-xs faint">beat the close</div>
                      </div>
                    </div>
                  </div>
                @endforeach
              </div>
            </div>
          @else
            <div class="p-7 mt-6 rounded-2xl card">
              <p class="font-bold text-lg">No signal has been scored yet.</p>
              <p class="mt-2 max-w-2xl leading-relaxed muted">
                A signal is scored once a market it argued about has closed. Until then every weight in the model is an assertion, including the ones that look most reasonable. {{ MIN_MEANINGFUL_SAMPLES }} scored decisions is roughly where a hit rate stops being a coin flip.
              </p>
            </div>
          @endif
        </section>

        <!-- providers -->
        <section class="mt-12">
          <h2 class="display font-black text-2xl tracking-tight">Sources</h2>
          @if (runs.length)
            <div class="overflow-hidden mt-6 rounded-2xl card">
              <div class="divide-y bd">
                @foreach (runs as run)
                  <div class="flex flex-col gap-2 items-start justify-between sm:flex-row sm:items-center px-5 py-4 sm:px-6">
                    <div class="min-w-0">
                      <div class="flex gap-2 items-center">
                        <span class="font-bold">{{ run.kind }}</span>
                        <span class="text-sm muted">{{ run.provider }}</span>
                      </div>
                      <div class="mt-0.5 text-sm truncate faint">{{ run.summary || 'no summary recorded' }}</div>
                    </div>
                    <div class="flex gap-6 items-center shrink-0">
                      <div class="text-right">
                        <div class="font-bold text-sm num">{{ run.rowsWritten.toLocaleString() }}</div>
                        <div class="text-xs faint">rows</div>
                      </div>
                      <div class="text-right">
                        <div class="font-bold text-sm {{ run.status === 'success' ? 'pos' : 'neg' }}">{{ run.status }}</div>
                        <div class="text-xs faint">{{ run.ageLabel }}</div>
                      </div>
                    </div>
                  </div>
                @endforeach
              </div>
            </div>
          @else
            <div class="px-6 py-10 mt-6 text-center rounded-2xl card">
              <p class="font-bold">The pipeline has never run.</p>
              <p class="mt-2 text-sm leading-relaxed muted">Start the scheduler and the first run lands within five minutes.</p>
            </div>
          @endif
        </section>
      </main>

      @include('footer')
    </div>

    <style>
      /* The simulated state is a warning, so it carries a warning edge
         rather than sitting in the same flat card as everything else. */
      .sim-card {
        border-color: color-mix(in srgb, var(--neg) 45%, transparent);
        background: color-mix(in srgb, var(--neg) 5%, var(--surface));
      }
    </style>
  </body>
</html>
