              <li class="grid gap-2 md:grid-cols-[13rem_1fr] md:gap-10 py-6">
                <h3 class="font-bold">{{ stage.name }}</h3>
                <p class="max-w-2xl leading-relaxed muted">{{ stage.detail }}</p>
              </li>
            @endforeach
          </ol>
