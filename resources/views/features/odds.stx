<script server>
/**
 * Feature page: odds comparison.
 *
 * Uses the live board summary and, when one exists, a real arbitrage so
 * the worked example is an actual current price rather than an invented
 * one that always happens to be profitable.
 */
import { loadBoard } from '../../../app/Support/odds'

const navActive = 'features'
const pageTitle = 'Odds comparison across books and prediction markets'
const pageDescription = 'Sportsbook prices and prediction-market probabilities on one row, with the best available price on each outcome ringed and cross-book arbitrage surfaced.'

const { events, summary } = await loadBoard()

const arb = events.find(e => e.hold && e.hold.isArbitrage) ?? null
const arbView = arb
  ? {
      title: arb.title,
      market: arb.market,
      returnPct: `${arb.hold.arbitragePct.toFixed(2)}%`,
      impliedSum: `${(arb.hold.bestBookSum * 100).toFixed(1)}%`,
      legs: arb.selections.map(s => ({
        label: s.label,
        price: s.bestPrice != null ? s.bestPrice.toFixed(2) : '-',
        american: s.bestAmerican ?? '-',
        implied: `${s.bestImpliedPct.toFixed(1)}%`,
      })),
    }
  : null
</script>

<!DOCTYPE html>
<html lang="en">
  <head>
    @include('head')
  </head>

  <body x-data="{ menu: false,
      theme: predicthqTheme.current(), toggleTheme() { this.theme = predicthqTheme.toggle() }, toggleMenu() { this.menu = !this.menu } }">
    <div class="app">
      @include('nav')

      <main class="mx-auto px-4 pt-14 sm:px-6 max-w-6xl sm:pt-20">
        <a href="/features" data-no-router class="text-sm font-semibold muted hover:opacity-70">Features</a>
        <h1 class="display mt-3 max-w-3xl font-black leading-[1.06] text-4xl tracking-tight sm:text-5xl">The same outcome, priced by everyone, on one row.</h1>
        <p class="mt-5 max-w-2xl leading-relaxed text-lg muted">
          Sportsbooks quote in American odds, prediction markets quote in probability. PredictHQ normalizes both to decimal, lines them up per outcome, and rings whoever is paying the most.
        </p>

        <div class="grid gap-px mt-12 grid-cols-2 sm:grid-cols-4 rounded-2xl overflow-hidden" style="background:var(--border)">
          <div class="p-5" style="background:var(--surface)">
            <div class="font-black text-2xl num">{{ summary.bookmakerCount }}</div>
            <div class="mt-1 font-semibold text-xs tracking-wide uppercase muted">Venues compared</div>
          </div>
          <div class="p-5" style="background:var(--surface)">
            <div class="font-black text-2xl num">{{ summary.eventCount }}</div>
            <div class="mt-1 font-semibold text-xs tracking-wide uppercase muted">Games on the board</div>
          </div>
          <div class="p-5" style="background:var(--surface)">
            <div class="font-black text-2xl num">{{ summary.selectionCount }}</div>
            <div class="mt-1 font-semibold text-xs tracking-wide uppercase muted">Outcomes priced</div>
          </div>
          <div class="p-5" style="background:var(--surface)">
            <div class="font-black text-2xl accent num">{{ summary.avgEdgePct.toFixed(1) }}%</div>
            <div class="mt-1 font-semibold text-xs tracking-wide uppercase muted">Avg best over field</div>
          </div>
        </div>

        <section class="mt-20">
          <h2 class="display font-black text-2xl tracking-tight sm:text-3xl">When the books disagree enough, both sides win</h2>
          <p class="mt-3 max-w-2xl leading-relaxed muted">
            Add up the implied probability of the best available price on every outcome. Below 100 percent, the field has mispriced the market against itself and a split stake returns a profit whichever way it lands.
          </p>

          @if (arbView)
            <div class="overflow-hidden mt-8 rounded-2xl card">
              <div class="flex flex-wrap gap-4 items-center justify-between px-5 py-5 border-b bd sm:px-6">
                <div>
                  <div class="font-bold text-xs tracking-wide uppercase faint">Live on the board · {{ arbView.market }}</div>
                  <div class="mt-1 font-bold text-lg">{{ arbView.title }}</div>
                </div>
                <div class="text-right">
                  <div class="font-semibold text-xs tracking-wide uppercase muted">Guaranteed return</div>
                  <div class="font-black text-2xl num pos">{{ arbView.returnPct }}</div>
                </div>
              </div>
              <div class="divide-y bd">
                @foreach (arbView.legs as leg)
                  <div class="flex items-center justify-between px-5 py-3.5 sm:px-6">
                    <span class="font-semibold text-sm">{{ leg.label }}</span>
                    <div class="flex gap-6 items-center text-sm">
                      <span class="num muted">{{ leg.implied }}</span>
                      <span class="num muted">{{ leg.american }}</span>
                      <span class="font-bold num">{{ leg.price }}</span>
                    </div>
                  </div>
                @endforeach
              </div>
              <div class="px-5 py-4 text-sm border-t bd sm:px-6" style="background:var(--surface-2)">
                <span class="muted">Implied probabilities sum to <span class="font-bold num" style="color:var(--text)">{{ arbView.impliedSum }}</span>, which is less than 100 percent. The gap is the return.</span>
              </div>
            </div>
          @else
            <div class="px-6 py-12 mt-8 text-center rounded-2xl card">
              <p class="font-bold">No arbitrage on the board right now.</p>
              <p class="mt-2 text-sm muted">This is the normal state. Books converge quickly, and a page that always has one to show you is showing you a fabricated one.</p>
            </div>
          @endif
        </section>

        <section class="grid gap-10 lg:grid-cols-2 mt-20">
          <div>
            <h2 class="display font-black text-2xl tracking-tight">Three notations, one number</h2>
            <p class="mt-3 leading-relaxed muted">
              Every price is available as decimal, American, and implied percentage, switchable on the board. They are the same quantity written three ways, and being able to flip between them is what makes a sportsbook line and a prediction-market probability actually comparable.
            </p>
          </div>
          <div>
            <h2 class="display font-black text-2xl tracking-tight">Hold is the number that matters</h2>
            <p class="mt-3 leading-relaxed muted">
              A single book's implied probabilities sum above 100 percent, and the excess is its margin. Combining the best price from every venue shrinks that margin, and the board shows what is left after shopping rather than what any one book advertises.
            </p>
          </div>
        </section>

        <section class="flex flex-col gap-5 items-start justify-between lg:flex-row lg:items-center p-8 mt-16 rounded-2xl card sm:p-10">
          <div>
            <h2 class="display font-black text-2xl tracking-tight">Open the board</h2>
            <p class="mt-2 max-w-xl leading-relaxed muted">Every game, every book, live. Tap a best price to start a sheet.</p>
          </div>
          <div class="flex flex-wrap gap-3 shrink-0">
            <a href="/" class="px-5 py-3 font-bold text-sm rounded-lg btn btn-primary">Go to the board</a>
            <a href="/features/live" data-no-router class="px-5 py-3 font-bold text-sm rounded-lg btn">Watch it move</a>
          </div>
        </section>
      </main>

      @include('footer')
    </div>
  </body>
</html>
