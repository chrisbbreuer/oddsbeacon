<script server>
/**
 * Feature page: bet sheets.
 *
 * The parlay maths is worked from real board prices, so the multiplier
 * on the page is one you could actually get right now rather than a
 * flattering invention.
 */
import { loadBoard } from '../../../app/Support/odds'

const navActive = 'features'
const pageTitle = 'Bet sheets: stack picks and track the parlay live'
const pageDescription = 'Add the best price on any outcome to a sheet, watch the combined odds and payout update against live prices, and save sheets to come back to.'

const { events } = await loadBoard()

// Three legs off the current board. A parlay example built from prices
// that are actually quoted is checkable; an invented one is decoration.
const legs = []
for (const ev of events) {
  if (legs.length >= 3)
    break
  const pick = ev.selections.find(s => s.bestPrice != null)
  if (!pick)
    continue
  legs.push({
    game: ev.title,
    label: pick.label,
    book: pick.bestBook ? pick.bestBook.name : 'best available',
    price: pick.bestPrice,
    priceLabel: pick.bestPrice.toFixed(2),
    american: pick.bestAmerican ?? '-',
  })
}

const combined = legs.reduce((acc, leg) => acc * leg.price, 1)
const combinedLabel = combined.toFixed(2)
const stake = 50
const payout = (stake * combined).toFixed(2)
const profit = (stake * combined - stake).toFixed(2)
const impliedLabel = combined > 0 ? `${(100 / combined).toFixed(1)}%` : '-'
</script>

<!DOCTYPE html>
<html lang="en">
  <head>
    @include('head')
  </head>

  <body x-data="{ menu: false,
      theme: predicthqTheme.current(), toggleTheme() { this.theme = predicthqTheme.toggle() }, toggleMenu() { this.menu = !this.menu } }">
    <div class="app">
      @include('nav')

      <main class="mx-auto px-4 pt-14 sm:px-6 max-w-6xl sm:pt-20">
        <a href="/features" data-no-router class="text-sm font-semibold muted hover:opacity-70">Features</a>
        <h1 class="display mt-3 max-w-3xl font-black leading-[1.06] text-4xl tracking-tight sm:text-5xl">Build the parlay at the best price on every leg.</h1>
        <p class="mt-5 max-w-2xl leading-relaxed text-lg muted">
          Tap the ringed price on any outcome and it joins your sheet. The combined price, the implied probability, and the payout recompute as you add legs and as the underlying prices move.
        </p>

        @if (legs.length >= 2)
          <section class="grid gap-6 lg:grid-cols-[1.4fr_1fr] mt-12">
            <div class="overflow-hidden rounded-2xl card">
              <div class="px-5 py-4 border-b bd sm:px-6">
                <h2 class="display font-bold">A sheet off today's board</h2>
                <p class="mt-1 text-sm muted">Best available price on each leg, right now.</p>
              </div>
              <div class="divide-y bd">
                @foreach (legs as leg)
                  <div class="flex flex-wrap gap-3 items-center justify-between px-5 py-4 sm:px-6">
                    <div class="min-w-0">
                      <div class="font-semibold">{{ leg.label }}</div>
                      <div class="mt-0.5 text-sm muted">{{ leg.game }} · {{ leg.book }}</div>
                    </div>
                    <div class="flex gap-5 items-center shrink-0">
                      <span class="text-sm num muted">{{ leg.american }}</span>
                      <span class="font-bold num">{{ leg.priceLabel }}</span>
                    </div>
                  </div>
                @endforeach
              </div>
            </div>

            <div class="p-6 rounded-2xl card sm:p-7">
              <h2 class="display font-bold">What it pays</h2>
              <div class="flex flex-col gap-4 mt-5">
                <div class="flex items-baseline justify-between">
                  <span class="text-sm muted">Combined price</span>
                  <span class="font-black text-2xl accent num">{{ combinedLabel }}</span>
                </div>
                <div class="flex items-baseline justify-between">
                  <span class="text-sm muted">Implied chance</span>
                  <span class="font-bold num">{{ impliedLabel }}</span>
                </div>
                <div class="flex items-baseline justify-between pt-4 border-t bd">
                  <span class="text-sm muted">Stake</span>
                  <span class="font-bold num">${{ stake }}</span>
                </div>
                <div class="flex items-baseline justify-between">
                  <span class="text-sm muted">Returns</span>
                  <span class="font-black text-xl num">${{ payout }}</span>
                </div>
                <div class="flex items-baseline justify-between">
                  <span class="text-sm muted">Profit</span>
                  <span class="font-bold num pos">${{ profit }}</span>
                </div>
              </div>
              <p class="pt-4 mt-5 text-xs leading-relaxed border-t faint bd">
                Every leg has to land. The implied chance above is what the market thinks that is worth, and it is the number worth looking at before the payout.
              </p>
            </div>
          </section>
        @endif

        <section class="grid gap-5 md:grid-cols-3 mt-20">
          <div class="p-6 rounded-2xl card">
            <h3 class="font-bold">Prices update under you</h3>
            <p class="mt-2 leading-relaxed text-sm muted">A sheet holds outcomes, not frozen numbers. When a leg's best price moves, the combined price moves with it, so what you are looking at is always what you could take now.</p>
          </div>
          <div class="p-6 rounded-2xl card">
            <h3 class="font-bold">Saved server-side</h3>
            <p class="mt-2 leading-relaxed text-sm muted">Name a sheet and it persists against your account, or against an anonymous token if you are not signed in. Closing the tab does not lose it.</p>
          </div>
          <div class="p-6 rounded-2xl card">
            <h3 class="font-bold">Shopping is the edge</h3>
            <p class="mt-2 leading-relaxed text-sm muted">Each leg takes the best price across every venue rather than one book's parlay quote. On a three-leg sheet those small per-leg gaps compound into the difference worth having.</p>
          </div>
        </section>

        <section class="flex flex-col gap-5 items-start justify-between lg:flex-row lg:items-center p-8 mt-16 rounded-2xl card sm:p-10">
          <div>
            <h2 class="display font-black text-2xl tracking-tight">Start a sheet</h2>
            <p class="mt-2 max-w-xl leading-relaxed muted">Open the board and tap any ringed price.</p>
          </div>
          <div class="flex flex-wrap gap-3 shrink-0">
            <a href="/" class="px-5 py-3 font-bold text-sm rounded-lg btn btn-primary">Go to the board</a>
            <a href="/features/odds" data-no-router class="px-5 py-3 font-bold text-sm rounded-lg btn">How pricing compares</a>
          </div>
        </section>
      </main>

      @include('footer')
    </div>
  </body>
</html>
