<script server>
/**
 * Feature page — the JSON API.
 *
 * The endpoint table is written by hand rather than generated, so it can
 * say what each route is FOR. A generated list of paths tells a reader
 * nothing they could not get from a 404.
 */
const navActive = 'features'
const pageTitle = 'Prin.tel JSON API'
const pageDescription = 'Every number on every page is a documented endpoint, including the candidate feed with its full evidence. Reads need no key.'

const readEndpoints = [
  { method: 'GET', path: '/api/trading/candidates', what: 'What the engine would price right now, with every signal and its sample size. Computed live, persisted nowhere, contacts no venue.' },
  { method: 'GET', path: '/api/trading/decisions', what: 'The decision feed. Each row ships with the evidence that produced it, so no second request is needed to explain one.' },
  { method: 'GET', path: '/api/markets/smart-money', what: 'Accounts ranked by shrunk win rate, with volume and sizing.' },
  { method: 'GET', path: '/api/markets/whales', what: 'Recent fills above the size threshold.' },
  { method: 'GET', path: '/api/markets/graph', what: 'The flow graph between accounts and markets, laid out server-side.' },
  { method: 'GET', path: '/api/odds', what: 'The full board: every event, every venue, every price.' },
  { method: 'GET', path: '/api/odds/best', what: 'Best available price per outcome, flattened.' },
  { method: 'GET', path: '/api/odds/arbitrage', what: 'Markets where the best prices across venues sum below one.' },
]

const writeEndpoints = [
  { method: 'GET', path: '/api/trading/strategies', what: 'Your strategies with live exposure and your plan entitlements.' },
  { method: 'POST', path: '/api/trading/strategies', what: 'Create or update a strategy. Limits are clamped, not just validated.' },
  { method: 'POST', path: '/api/trading/accounts', what: 'Connect a venue. Credentials are verified against the venue before they are stored as usable.' },
  { method: 'POST', path: '/api/trading/decisions/{id}/review', what: 'Approve or reject a queued decision. Approving runs the same executor the schedule does.' },
  { method: 'POST', path: '/api/billing/checkout', what: 'Start a subscription. Takes a plan key, never a Stripe price id.' },
]

const sample = `{
  "count": 1,
  "minEdge": 0.03,
  "candidates": [
    {
      "venue": "polymarket",
      "question": "Bitcoin Up or Down",
      "side": "up",
      "marketPrice": 0.34,
      "fairValue": 0.403,
      "edge": 0.063,
      "confidence": 0.691,
      "evidence": [
        {
          "kind": "flow_imbalance",
          "summary": "97.0% of $3008.98 traded in 24h bought up",
          "value": 0.9697,
          "contribution": 0.063,
          "sampleSize": 64,
          "windowHours": 24
        }
      ]
    }
  ]
}`
</script>

<!DOCTYPE html>
<html lang="en">
  <head>
    @include('head')
  </head>

  <body x-data="{ theme: printelTheme.current(), toggleTheme() { this.theme = printelTheme.toggle() } }">
    <div class="app">
      @include('nav')

      <main class="mx-auto px-4 pt-14 sm:px-6 max-w-6xl sm:pt-20">
        <a href="/features" data-no-router class="text-sm font-semibold muted hover:opacity-70">Features</a>
        <h1 class="mt-3 max-w-3xl font-black leading-[1.06] text-4xl tracking-tight sm:text-5xl">Every number on this site is an endpoint.</h1>
        <p class="mt-5 max-w-2xl leading-relaxed text-lg muted">
          The pages have no privileged data source. They call the same routes you can, and the read routes need no key, which means a claim on any page can be checked against the response that produced it.
        </p>

        <section class="mt-16">
          <div class="flex flex-wrap gap-3 items-baseline justify-between pb-4 border-b bd">
            <h2 class="font-black text-2xl tracking-tight">Reads</h2>
            <p class="text-sm muted">No authentication. Safe to poll.</p>
          </div>
          <div class="divide-y bd">
            @foreach (readEndpoints as ep)
              <div class="grid gap-2 md:grid-cols-[4rem_18rem_1fr] md:gap-6 py-4 items-baseline">
                <span class="font-bold text-xs num accent">{{ ep.method }}</span>
                <code class="text-sm num">{{ ep.path }}</code>
                <p class="text-sm leading-relaxed muted">{{ ep.what }}</p>
              </div>
            @endforeach
          </div>
        </section>

        <section class="mt-16">
          <div class="flex flex-wrap gap-3 items-baseline justify-between pb-4 border-b bd">
            <h2 class="font-black text-2xl tracking-tight">Writes</h2>
            <p class="text-sm muted">Authenticated. Plan limits are enforced per field.</p>
          </div>
          <div class="divide-y bd">
            @foreach (writeEndpoints as ep)
              <div class="grid gap-2 md:grid-cols-[4rem_18rem_1fr] md:gap-6 py-4 items-baseline">
                <span class="font-bold text-xs num accent">{{ ep.method }}</span>
                <code class="text-sm num">{{ ep.path }}</code>
                <p class="text-sm leading-relaxed muted">{{ ep.what }}</p>
              </div>
            @endforeach
          </div>
        </section>

        <section class="mt-20">
          <h2 class="font-black text-2xl tracking-tight sm:text-3xl">A candidate, in full</h2>
          <p class="mt-3 max-w-2xl leading-relaxed muted">
            Trimmed to one signal for length. The real response carries every signal that fired, and quoted price plus the contributions equals fair value exactly.
          </p>
          <pre class="overflow-x-auto p-5 mt-6 text-xs leading-relaxed rounded-2xl card num sm:p-6"><code>{{ sample }}</code></pre>
        </section>

        <section class="flex flex-col gap-5 items-start justify-between lg:flex-row lg:items-center p-8 mt-16 rounded-2xl card sm:p-10">
          <div>
            <h2 class="font-black text-2xl tracking-tight">Try it now</h2>
            <p class="mt-2 max-w-xl leading-relaxed muted">The candidate feed is open in a browser tab.</p>
          </div>
          <div class="flex flex-wrap gap-3 shrink-0">
            <a href="/api/trading/candidates" data-no-router class="px-5 py-3 font-bold text-sm rounded-lg btn btn-primary">Open the feed</a>
            <a href="/features/evidence" data-no-router class="px-5 py-3 font-bold text-sm rounded-lg btn">What the fields mean</a>
          </div>
        </section>
      </main>

      @include('footer')
    </div>
  </body>
</html>
