<script server>
/**
 * Feature page: the evidence engine.
 *
 * Renders the strongest live candidate rather than an illustration. A
 * page arguing that reasoning is inspectable has to be inspectable, and
 * a mocked example would be the one thing that disproves the claim.
 */
import { loadTopCandidate } from '../../../app/Support/intel'

const navActive = 'features'
const pageTitle = 'Evidence engine: how PredictHQ prices a market'
const pageDescription = 'Six measured signals move fair value off the venue quote. Each is clamped, each records its sample size, and together they reconstruct any decision without re-running anything.'

const candidate = await loadTopCandidate()

const signals = [
  {
    name: 'Flow imbalance',
    what: 'What share of the money over the window bought this side.',
    why: 'Centered on the price itself, not on half. A side quoted at 80 percent should already attract most of the flow, so only the excess carries information.',
    cap: '±8 points',
  },
  {
    name: 'Smart money',
    what: 'The same flow, weighted by each buyer\'s track record.',
    why: 'Only meaningful where fills are attributable. Kalshi\'s tape is anonymous, so this signal is skipped there rather than reported as a real zero.',
    cap: '±8 points',
  },
  {
    name: 'Trader accuracy',
    what: 'How the accounts on this side have done on markets that settled.',
    why: 'Shrunk toward a coin flip with six pseudo-observations, so a 2-for-2 record cannot outrank 40-for-50.',
    cap: '±8 points',
  },
  {
    name: 'Price trend',
    what: 'Where the side has traded in the last four hours against the full window.',
    why: 'Drift, not level. A side that has been steady all day contributes nothing here, which is why you will often see this one at zero.',
    cap: '±8 points',
  },
  {
    name: 'Cross venue',
    what: 'The other venue\'s price on the same question.',
    why: 'The only signal that does not depend on our own trader modelling. Two venues disagreeing is the cleanest evidence available.',
    cap: '±8 points',
  },
  {
    name: 'Liquidity',
    what: 'Depth resting on the book.',
    why: 'Recorded but never directional. It caps how large a position can be without moving the price, and it always contributes exactly zero.',
    cap: 'Zero by design',
  },
]
</script>

<!DOCTYPE html>
<html lang="en">
  <head>
    @include('head')
  </head>

  <body x-data="{ menu: false,
      theme: predicthqTheme.current(), toggleTheme() { this.theme = predicthqTheme.toggle() }, toggleMenu() { this.menu = !this.menu } }">
    <div class="app">
      @include('nav')

      <main class="mx-auto px-4 pt-14 sm:px-6 max-w-6xl sm:pt-20">
        <a href="/features" data-no-router class="text-sm font-semibold muted hover:opacity-70">Features</a>
        <h1 class="display mt-3 max-w-3xl font-black leading-[1.06] text-4xl tracking-tight sm:text-5xl">Fair value, and the arithmetic that got there.</h1>
        <p class="mt-5 max-w-2xl leading-relaxed text-lg muted">
          Every price starts at what the venue is quoting, because the market is the best single estimate available. Six signals move it from there. None of them is allowed to move it far.
        </p>

        @if (candidate)
          <section class="overflow-hidden mt-12 rounded-2xl card">
            <div class="flex flex-col gap-4 items-start justify-between md:flex-row md:items-center px-5 py-5 border-b bd sm:px-6">
              <div class="min-w-0">
                <div class="font-bold text-xs tracking-wide uppercase faint">Live candidate · {{ candidate.venue }}</div>
                <div class="mt-1 font-bold text-lg leading-snug">{{ candidate.question }}</div>
              </div>
              <div class="flex gap-7 shrink-0">
                <div>
                  <div class="font-semibold text-xs tracking-wide uppercase muted">Quoted</div>
                  <div class="font-black text-xl num">{{ candidate.marketPricePct }}</div>
                </div>
                <div>
                  <div class="font-semibold text-xs tracking-wide uppercase muted">Fair value</div>
                  <div class="font-black text-xl accent num">{{ candidate.fairValuePct }}</div>
                </div>
                <div>
                  <div class="font-semibold text-xs tracking-wide uppercase muted">Edge</div>
                  <div class="font-black text-xl num pos">{{ candidate.edgePts }} pts</div>
                </div>
              </div>
            </div>

            <div class="divide-y bd">
              @foreach (candidate.evidence as item)
                <div class="flex flex-col gap-1 items-start justify-between sm:flex-row sm:items-center sm:gap-6 px-5 py-4 sm:px-6">
                  <div class="min-w-0">
                    <span class="font-bold text-sm">{{ item.label }}</span>
                    <span class="ml-2 text-sm muted">{{ item.summary }}</span>
                  </div>
                  <div class="flex gap-5 items-center shrink-0">
                    <span class="text-xs faint num">n = {{ item.sampleSize.toLocaleString() }}</span>
                    <span class="font-bold text-sm num {{ item.points === 'context' ? 'muted' : (item.positive ? 'pos' : 'neg') }}">{{ item.points }}</span>
                  </div>
                </div>
              @endforeach
            </div>

            <div class="px-5 py-4 text-sm border-t bd sm:px-6" style="background:var(--surface-2)">
              <span class="muted">Quoted price plus the contributions above equals fair value exactly. That identity is what makes a decision reconstructible from its stored rows.</span>
            </div>
          </section>
        @else
          <section class="px-6 py-12 mt-12 text-center rounded-2xl card">
            <p class="font-bold">Nothing priced right now.</p>
            <p class="mt-2 text-sm muted">No market in the last 24 hours of tape carries enough flow to price against. The engine gives itself the same answer.</p>
          </section>
        @endif

        <section class="mt-20">
          <h2 class="display max-w-2xl font-black text-2xl tracking-tight sm:text-3xl">The six signals</h2>
          <div class="mt-8 divide-y bd">
            @foreach (signals as signal)
              <div class="grid gap-2 md:grid-cols-[13rem_1fr_8rem] md:gap-8 py-6">
                <h3 class="font-bold">{{ signal.name }}</h3>
                <div>
                  <p class="leading-relaxed">{{ signal.what }}</p>
                  <p class="mt-1.5 leading-relaxed text-sm muted">{{ signal.why }}</p>
                </div>
                <span class="font-semibold text-sm num faint md:text-right">{{ signal.cap }}</span>
              </div>
            @endforeach
          </div>
        </section>

        <section class="grid gap-10 lg:grid-cols-2 mt-20">
          <div>
            <h2 class="display font-black text-2xl tracking-tight">Why everything is clamped</h2>
            <p class="mt-3 leading-relaxed muted">
              No single signal may move fair value more than eight points, and all of them together may not move it more than fifteen. Without those bounds one unusual hour of flow can produce a confident-looking price that nothing else supports, and the resulting order is large precisely when the estimate is worst.
            </p>
          </div>
          <div>
            <h2 class="display font-black text-2xl tracking-tight">Why sample size is stored</h2>
            <p class="mt-3 leading-relaxed muted">
              A signal standing on three fills and one standing on three hundred can produce the same number, and they are not the same claim. Recording n next to every contribution is what lets you tell them apart later, and it is what confidence is actually computed from.
            </p>
          </div>
        </section>

        <section class="flex flex-col gap-5 items-start justify-between lg:flex-row lg:items-center p-8 mt-16 rounded-2xl card sm:p-10">
          <div>
            <h2 class="display font-black text-2xl tracking-tight">What happens to a price once it exists</h2>
            <p class="mt-2 max-w-xl leading-relaxed muted">A model reviews it, your limits size it, and the risk checks decide whether it leaves the process.</p>
          </div>
          <div class="flex flex-wrap gap-3 shrink-0">
            <a href="/features/automation" data-no-router class="px-5 py-3 font-bold text-sm rounded-lg btn btn-primary">Automated trading</a>
            <a href="/features/risk" data-no-router class="px-5 py-3 font-bold text-sm rounded-lg btn">Risk limits</a>
          </div>
        </section>
      </main>

      @include('footer')
    </div>
  </body>
</html>
