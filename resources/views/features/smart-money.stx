<script server>
/**
 * Feature page: smart money.
 *
 * Shows the live leaderboard rather than describing one. The scoring is
 * the interesting part and it is easier to trust when the numbers on the
 * page are the numbers the engine is using.
 */
import { loadSmartMoney } from '../../../app/Support/prediction-markets'

const navActive = 'features'
const pageTitle = 'Smart money: who keeps buying the winning side'
const pageDescription = 'Per-account win rates on settled prediction markets, shrunk toward a coin flip so a small sample never outranks a long record.'

const traders = loadSmartMoney(8)

const fmtUsd = (n) => {
  if (n >= 1_000_000) return `$${(n / 1_000_000).toFixed(1)}M`
  if (n >= 1_000) return `$${(n / 1_000).toFixed(1)}k`
  return `$${Math.round(n)}`
}

const rows = traders.map(t => ({
  alias: t.alias || `${t.externalId.slice(0, 6)}…${t.externalId.slice(-4)}`,
  score: t.smartScore.toFixed(0),
  winRate: t.resolvedTradeCount > 0 ? `${Math.round(t.winRate * 100)}%` : 'unsettled',
  record: t.resolvedTradeCount > 0 ? `${t.winningTradeCount}/${t.resolvedTradeCount}` : '0/0',
  volume: fmtUsd(t.totalNotional),
  avg: fmtUsd(t.avgTradeSize),
  whale: t.isWhale,
}))
</script>

<!DOCTYPE html>
<html lang="en">
  <head>
    @include('head')
  </head>

  <body x-data="{ menu: false,
      theme: predicthqTheme.current(), toggleTheme() { this.theme = predicthqTheme.toggle() }, toggleMenu() { this.menu = !this.menu } }">
    <div class="app">
      @include('nav')

      <main class="mx-auto px-4 pt-14 sm:px-6 max-w-6xl sm:pt-20">
        <a href="/features" data-no-router class="text-sm font-semibold muted hover:opacity-70">Features</a>
        <h1 class="display mt-3 max-w-3xl font-black leading-[1.06] text-4xl tracking-tight sm:text-5xl">Not who bets loudest. Who keeps being right.</h1>
        <p class="mt-5 max-w-2xl leading-relaxed text-lg muted">
          Polymarket fills carry the taker's wallet, so accuracy per account is a real measurement rather than an inference. Once a market settles, every fill on it is scored, and the accounts behind the winning side accumulate a record.
        </p>

        @if (rows.length > 0)
          <section class="overflow-x-auto mt-12 rounded-2xl card">
            <table class="w-full text-sm min-w-[640px]">
              <thead>
                <tr class="border-b bd">
                  <th class="px-5 py-3.5 font-bold text-xs tracking-wide text-left uppercase sm:px-6 muted">Account</th>
                  <th class="px-4 py-3.5 font-bold text-xs tracking-wide text-right uppercase muted">Score</th>
                  <th class="px-4 py-3.5 font-bold text-xs tracking-wide text-right uppercase muted">Win rate</th>
                  <th class="px-4 py-3.5 font-bold text-xs tracking-wide text-right uppercase muted">Record</th>
                  <th class="px-4 py-3.5 font-bold text-xs tracking-wide text-right uppercase muted">Volume</th>
                  <th class="px-5 py-3.5 font-bold text-xs tracking-wide text-right uppercase sm:px-6 muted">Avg size</th>
                </tr>
              </thead>
              <tbody class="divide-y bd">
                @foreach (rows as row)
                  <tr>
                    <td class="px-5 py-3.5 font-semibold sm:px-6">
                      {{ row.alias }}
                      @if (row.whale)
                        <span class="ml-2 px-2 py-0.5 font-bold text-[10px] tracking-wide uppercase rounded-full" style="background:var(--accent-weak);color:var(--accent-strong)">size</span>
                      @endif
                    </td>
                    <td class="px-4 py-3.5 font-bold text-right accent num">{{ row.score }}</td>
                    <td class="px-4 py-3.5 text-right num">{{ row.winRate }}</td>
                    <td class="px-4 py-3.5 text-right num muted">{{ row.record }}</td>
                    <td class="px-4 py-3.5 text-right num">{{ row.volume }}</td>
                    <td class="px-5 py-3.5 text-right sm:px-6 num muted">{{ row.avg }}</td>
                  </tr>
                @endforeach
              </tbody>
            </table>
          </section>
        @else
          <section class="px-6 py-12 mt-12 text-center rounded-2xl card">
            <p class="font-bold">No scored accounts yet.</p>
            <p class="mt-2 text-sm muted">Accounts appear here once markets they traded have settled and their fills have been scored.</p>
          </section>
        @endif

        <section class="grid gap-10 lg:grid-cols-2 mt-20">
          <div>
            <h2 class="display font-black text-2xl tracking-tight">Why the score is not the win rate</h2>
            <p class="mt-3 leading-relaxed muted">
              A raw win rate rewards small samples: two correct trades reads as 100 percent and would outrank forty correct out of fifty. The score shrinks each record toward a coin flip with six pseudo-observations before rescaling, so sustained accuracy earns a high number and a lucky pair does not. The raw record is shown next to it so you can see what the shrinkage did.
            </p>
          </div>
          <div>
            <h2 class="display font-black text-2xl tracking-tight">Why Kalshi has no leaderboard</h2>
            <p class="mt-3 leading-relaxed muted">
              Kalshi's public tape is anonymous. There is no account to attribute a fill to, so there is no honest way to build a track record from it. Rather than invent one, Kalshi contributes flow rather than identity, and the smart-money signal is skipped there instead of being reported as a real zero.
            </p>
          </div>
        </section>

        <section class="flex flex-col gap-5 items-start justify-between lg:flex-row lg:items-center p-8 mt-16 rounded-2xl card sm:p-10">
          <div>
            <h2 class="display font-black text-2xl tracking-tight">See the money move</h2>
            <p class="mt-2 max-w-xl leading-relaxed muted">The full leaderboard, the whale feed, and the flow graph between accounts and markets.</p>
          </div>
          <div class="flex flex-wrap gap-3 shrink-0">
            <a href="/markets" data-no-router class="px-5 py-3 font-bold text-sm rounded-lg btn btn-primary">Open smart money</a>
            <a href="/features/evidence" data-no-router class="px-5 py-3 font-bold text-sm rounded-lg btn">How it prices</a>
          </div>
        </section>
      </main>

      @include('footer')
    </div>
  </body>
</html>
