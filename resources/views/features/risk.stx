<script server>
/**
 * Feature page — risk limits.
 *
 * Structured as the ladder the executor actually walks, in the order it
 * walks it, because the order is the design: the cheap local checks run
 * before anything touches a venue.
 */
const navActive = 'features'
const pageTitle = 'Risk limits: what Prin.tel refuses to do'
const pageDescription = 'Bankroll, per-trade cap, open positions, and a daily loss limit are re-checked before every order. Every refusal is stored with its reason.'

const checks = [
  {
    order: 'First',
    name: 'Strategy state',
    detail: 'Paused or halted strategies stop here. Halting is sticky: it is written to the strategy, survives a restart, and carries the reason it happened.',
  },
  {
    order: 'Then',
    name: 'Plan entitlement',
    detail: 'Automated execution needs a plan that includes it. A lapsed subscription stops placing orders rather than continuing on the assumption the card recovers.',
  },
  {
    order: 'Then',
    name: 'Daily loss limit',
    detail: 'Measured on realized cost from filled orders since midnight UTC, not on marked-to-market swings. A limit that trips on an unrealized move halts a strategy over a price change that has cost nothing.',
  },
  {
    order: 'Then',
    name: 'Open positions',
    detail: 'A hard count of orders still live or filled and unsettled. It is the cap on how many things can go wrong at once.',
  },
  {
    order: 'Then',
    name: 'Bankroll',
    detail: 'Committed notional plus this order must fit inside the bankroll you declared. The declared number is the ceiling, never a target to fill.',
  },
  {
    order: 'Then',
    name: 'Venue health',
    detail: 'The account must exist and be active. Credentials the venue has rejected mark the account revoked, so the next pass stops here instead of burning a round trip per decision.',
  },
  {
    order: 'Last',
    name: 'The order itself',
    detail: 'Only now does anything leave the process. The venue is asked last because it is the only check that costs a network call.',
  },
]
</script>

<!DOCTYPE html>
<html lang="en">
  <head>
    @include('head')
  </head>

  <body x-data="{ theme: (localStorage.getItem('ob-theme') || 'light'), toggleTheme() { this.theme = this.theme === 'dark' ? 'light' : 'dark'; localStorage.setItem('ob-theme', this.theme) } }">
    <div class="app" :data-theme="theme">
      @include('nav')

      <main class="mx-auto px-4 pt-14 sm:px-6 max-w-6xl sm:pt-20">
        <a href="/features" data-no-router class="text-sm font-semibold muted hover:opacity-70">Features</a>
        <h1 class="mt-3 max-w-3xl font-black leading-[1.06] text-4xl tracking-tight sm:text-5xl">A quiet strategy is never a mystery.</h1>
        <p class="mt-5 max-w-2xl leading-relaxed text-lg muted">
          Every limit is a ceiling, not a target, and every refusal is written to the decision that was refused. A strategy that found no edge and one that is out of bankroll look nothing alike, which is the whole point.
        </p>

        <section class="mt-16">
          <h2 class="font-black text-2xl tracking-tight sm:text-3xl">The order of the checks is the design</h2>
          <p class="mt-3 max-w-2xl leading-relaxed muted">
            They run cheapest first. By the time a venue is contacted, six other things have already agreed the order should exist.
          </p>

          <ol class="mt-8 divide-y bd">
            @foreach (checks as check)
              <li class="grid gap-2 md:grid-cols-[5rem_11rem_1fr] md:gap-8 py-6">
                <span class="font-semibold text-sm faint">{{ check.order }}</span>
                <h3 class="font-bold">{{ check.name }}</h3>
                <p class="max-w-2xl leading-relaxed muted">{{ check.detail }}</p>
              </li>
            @endforeach
          </ol>
        </section>

        <section class="grid gap-5 md:grid-cols-3 mt-20">
          <div class="p-6 rounded-2xl card">
            <h3 class="font-bold">Sizing is deliberately timid</h3>
            <p class="mt-2 leading-relaxed text-sm muted">Quarter-Kelly, scaled again by confidence. It gives up some growth in exchange for a lot of tolerance to being wrong about fair value, which is the right trade when the probability is an estimate.</p>
          </div>
          <div class="p-6 rounded-2xl card">
            <h3 class="font-bold">One decision, one order</h3>
            <p class="mt-2 leading-relaxed text-sm muted">Decisions are unique per strategy and market, so a re-run that still sees the same edge updates its opinion instead of stacking a second order. Orders carry an idempotency key, so a retry cannot fill twice.</p>
          </div>
          <div class="p-6 rounded-2xl card">
            <h3 class="font-bold">Failures do not cascade</h3>
            <p class="mt-2 leading-relaxed text-sm muted">A venue rejecting one order does not stop the rest, and one strategy failing does not stop another user's pass. The alternative is a single bad market silently disabling everything.</p>
          </div>
        </section>

        <section class="p-8 mt-16 rounded-2xl card sm:p-10">
          <h2 class="font-black text-2xl tracking-tight">What Prin.tel does not claim</h2>
          <p class="mt-3 max-w-3xl leading-relaxed muted">
            A modelled edge is an estimate from a trade tape, and it can be wrong. These limits bound how much any single mistake costs; they do not make the mistakes less likely, and they cannot make a losing strategy profitable. Prin.tel does not know your circumstances and nothing it produces is financial advice.
          </p>
        </section>
      </main>

      @include('footer')
    </div>
  </body>
</html>
