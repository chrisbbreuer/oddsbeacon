<script server>
/**
 * PredictHQ - community.
 *
 * Threads are per market, not global. "What do we think about this
 * contract" stays useful a week later; a general chat room does not.
 *
 * Renders real rows. On a database with no notes yet the page opens a
 * thread on real markets instead of showing invented conversation.
 */
import { loadSeedMarkets, loadThreads } from '../../app/Support/community'

const navActive = 'community'
const pageTitle = 'PredictHQ community: talk the calls through'
const pageDescription = 'Per-market threads where people trading the same contracts compare reasoning, take a side, and say why.'

const threads = await loadThreads(12)
const seeds = threads.length === 0 ? await loadSeedMarkets(6) : []

const totalNotes = threads.reduce((n, t) => n + t.noteCount, 0)
</script>

<!DOCTYPE html>
<html lang="en">
  <head>
    @include('head')
  </head>

  <body x-data="{ menu: false, theme: predicthqTheme.current(), toggleTheme() { this.theme = predicthqTheme.toggle() }, toggleMenu() { this.menu = !this.menu },
    openId: 0,
    draft: '',
    name: '',
    stance: 'watching',
    busy: false,
    error: '',
    open(id) { this.openId = this.openId === id ? 0 : id; this.error = '' },
    async send(id) {
      if (!this.draft.trim() || this.busy) return
      this.busy = true
      this.error = ''
      try {
        // CSRF is a stateless double-submit: the server sets a non-HttpOnly
        // X-CSRF-Token cookie on safe responses and expects the same value
        // echoed in the header. Reading it here is the whole client half.
        const csrf = (document.cookie.match(/(?:^|;\s*)X-CSRF-Token=([^;]+)/) || [])[1] || ''
        const res = await fetch('/api/community/notes', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': decodeURIComponent(csrf) },
          body: JSON.stringify({ predictionMarketId: id, body: this.draft, authorName: this.name, stance: this.stance }),
        })
        if (!res.ok) {
          const d = await res.json().catch(() => ({}))
          this.error = d.message || 'That did not save. Try again.'
          this.busy = false
          return
        }
        location.reload()
      } catch (e) {
        this.error = 'Could not reach the server.'
        this.busy = false
      }
    },
  }">
    <div class="app">
      @include('nav')

      <main class="mx-auto px-4 pt-14 sm:px-6 max-w-6xl sm:pt-20">
        <h1 class="display max-w-3xl font-black leading-[1.06] text-4xl tracking-tight sm:text-5xl">Talk the calls through.</h1>
        <p class="mt-5 max-w-2xl leading-relaxed text-lg muted">
          A thread per market, for the people trading it. Take a side, say why, and see who disagreed before the market settled.
        </p>

        @if (threads.length > 0)
          <p class="mt-6 text-sm num faint">{{ totalNotes.toLocaleString() }} {{ totalNotes === 1 ? "note" : "notes" }} across {{ threads.length }} {{ threads.length === 1 ? "thread" : "threads" }}</p>

          <section class="flex flex-col gap-4 mt-10">
            @foreach (threads as t)
              <article class="overflow-hidden rounded-2xl card">
                <div class="flex flex-wrap gap-4 items-start justify-between px-5 py-5 sm:px-6">
                  <div class="min-w-0">
                    <div class="font-bold text-xs tracking-wide uppercase faint">{{ t.venue }}</div>
                    <h2 class="display mt-1 font-bold text-lg leading-snug">{{ t.question }}</h2>
                  </div>
                  <div class="flex gap-5 shrink-0 text-sm">
                    <span class="num pos">{{ t.yes }} yes</span>
                    <span class="num neg">{{ t.no }} no</span>
                    <span class="num muted">{{ t.watching }} watching</span>
                  </div>
                </div>

                <div class="divide-y bd">
                  @foreach (t.latest as note)
                    <div class="px-5 py-4 sm:px-6">
                      <div class="flex gap-2 items-baseline">
                        <span class="font-semibold text-sm">{{ note.authorName }}</span>
                        <span class="text-xs num faint">{{ note.stance }}</span>
                      </div>
                      <p class="mt-1 leading-relaxed text-sm muted">{{ note.body }}</p>
                    </div>
                  @endforeach
                </div>

                <div class="px-5 py-4 border-t bd sm:px-6" style="background:var(--surface-2)">
                  <button class="font-bold text-sm accent" @click="open({{ t.marketId }})">
                    <span x-show="openId !== {{ t.marketId }}">Add a note</span>
                    <span x-show="openId === {{ t.marketId }}" style="display:none">Close</span>
                  </button>

                  <div x-show="openId === {{ t.marketId }}" x-cloak class="mt-4">
                    <label class="block font-semibold text-xs tracking-wide uppercase muted" :for="'body-{{ t.marketId }}'">Your note</label>
                    <textarea
                      :id="'body-{{ t.marketId }}'"
                      x-model="draft"
                      rows="3"
                      class="px-3 py-2 mt-2 w-full text-sm rounded-lg input"
                      placeholder="What are you seeing that the price is not?"
                    ></textarea>

                    <div class="flex flex-wrap gap-3 items-end mt-3">
                      <div>
                        <label class="block font-semibold text-xs tracking-wide uppercase muted" :for="'name-{{ t.marketId }}'">Name</label>
                        <input :id="'name-{{ t.marketId }}'" x-model="name" class="px-3 py-2 mt-1.5 text-sm rounded-lg input" placeholder="Optional">
                      </div>
                      <div>
                        <label class="block font-semibold text-xs tracking-wide uppercase muted" :for="'stance-{{ t.marketId }}'">Stance</label>
                        <select :id="'stance-{{ t.marketId }}'" x-model="stance" class="px-3 py-2 mt-1.5 text-sm rounded-lg input">
                          <option value="watching">Watching</option>
                          <option value="yes">Yes</option>
                          <option value="no">No</option>
                        </select>
                      </div>
                      <button class="px-4 py-2 font-bold text-sm rounded-lg btn btn-primary" @click="send({{ t.marketId }})" :disabled="busy">
                        <span x-show="!busy">Post</span>
                        <span x-show="busy" style="display:none">Posting</span>
                      </button>
                    </div>

                    <p x-show="error" x-cloak class="mt-2 text-sm neg" x-text="error"></p>
                  </div>
                </div>
              </article>
            @endforeach
          </section>
        @else
          <section class="p-8 mt-10 rounded-2xl card sm:p-10">
            <h2 class="display font-black text-2xl tracking-tight">No threads open yet.</h2>
            <p class="mt-2 max-w-xl leading-relaxed muted">
              Nobody has said anything yet, so there is nothing to show you. These are markets currently being tracked. Opening one starts its thread.
            </p>

            @if (seeds.length > 0)
              <div class="flex flex-col gap-px mt-7 rounded-xl overflow-hidden" style="background:var(--border)">
                @foreach (seeds as m)
                  <div class="flex flex-wrap gap-3 items-center justify-between px-5 py-4" style="background:var(--surface)">
                    <div class="min-w-0">
                      <div class="font-bold text-xs tracking-wide uppercase faint">{{ m.venue }}</div>
                      <div class="mt-0.5 font-semibold">{{ m.question }}</div>
                    </div>
                    <button class="px-4 py-2 font-bold text-sm rounded-lg shrink-0 btn" @click="open({{ m.id }})">Start the thread</button>
                  </div>

                  <div x-show="openId === {{ m.id }}" x-cloak class="px-5 py-4" style="background:var(--surface-2)">
                    <textarea x-model="draft" rows="3" class="px-3 py-2 w-full text-sm rounded-lg input" placeholder="What are you seeing that the price is not?"></textarea>
                    <div class="flex flex-wrap gap-3 items-end mt-3">
                      <input x-model="name" class="px-3 py-2 text-sm rounded-lg input" placeholder="Name, optional">
                      <select x-model="stance" class="px-3 py-2 text-sm rounded-lg input">
                        <option value="watching">Watching</option>
                        <option value="yes">Yes</option>
                        <option value="no">No</option>
                      </select>
                      <button class="px-4 py-2 font-bold text-sm rounded-lg btn btn-primary" @click="send({{ m.id }})" :disabled="busy">
                        <span x-show="!busy">Post</span>
                        <span x-show="busy" style="display:none">Posting</span>
                      </button>
                    </div>
                    <p x-show="error" x-cloak class="mt-2 text-sm neg" x-text="error"></p>
                  </div>
                @endforeach
              </div>
            @endif
          </section>
        @endif
      </main>

      @include('footer')
    </div>
  </body>
</html>
