<header
  class="sticky top-0 z-30 border-b bd"
  style="background:color-mix(in srgb, var(--surface) 86%, transparent);backdrop-filter:blur(14px)"
>
  <div class="flex gap-3 items-center justify-between mx-auto px-4 py-3 sm:px-6 max-w-6xl">
    <a href="/" class="flex gap-2.5 items-center shrink-0">
      <span class="grid place-items-center h-9 w-9 p-2 rounded-xl brandmark">@include('logo')</span>
      <span class="font-extrabold text-lg tracking-tight">Predict<span class="accent">HQ</span></span>
    </a>

    {{--
      Kept to five items so it never wraps to a second line at lg, which
      is where a nav stops being navigation and starts being a layout bug.
      The per-page `navActive` const is read straight out of the including
      page's scope.
    --}}
    <nav class="hidden gap-7 items-center font-semibold text-sm lg:flex muted">
      <a href="/features" data-no-router class="hover:opacity-70 {{ navActive === 'features' ? 'accent' : '' }}">Features</a>
      <a href="/markets" data-no-router class="hover:opacity-70 {{ navActive === 'markets' ? 'accent' : '' }}">Smart money</a>
      <a href="/scores/nfl/today" data-no-router class="hover:opacity-70 {{ navActive === 'scores' ? 'accent' : '' }}">Scores</a>
      <a href="/community" data-no-router class="hover:opacity-70 {{ navActive === 'community' ? 'accent' : '' }}">Community</a>
      <a href="/" class="hover:opacity-70 {{ navActive === 'board' ? 'accent' : '' }}">Odds</a>
      <a href="/pricing" data-no-router class="hover:opacity-70 {{ navActive === 'pricing' ? 'accent' : '' }}">Pricing</a>
    </nav>

    <div class="flex gap-2 items-center shrink-0">
      <button class="grid place-items-center h-9 w-9 rounded-lg icon-btn" @click="toggleTheme()" aria-label="Toggle theme">
        <i class="h-4 w-4 i-hugeicons-moon-02" x-show="theme !== 'dark'"></i>
        <i class="h-4 w-4 i-hugeicons-sun-03" x-show="theme === 'dark'" style="display:none"></i>
      </button>
      @if (navActive === 'board')
        <button class="hidden gap-2 items-center px-4 py-2 font-bold text-sm rounded-lg sm:inline-flex btn btn-primary" @click="drawer = true">
          My sheet
          <span class="grid place-items-center h-5 min-w-5 px-1 text-xs rounded-full" style="background:rgba(0,0,0,0.18)" x-text="sheet.length"></span>
        </button>
      @else
        <a href="/pricing" data-no-router class="hidden px-4 py-2 font-bold text-sm rounded-lg sm:inline-block btn btn-primary">Start</a>
      @endif

      {{--
        Below lg the five links were simply `hidden`, and the CTA was hidden
        below sm, so a phone got a logo and a theme toggle and no way to
        reach any other page. This is that missing half.
      --}}
      <button
        class="grid place-items-center h-9 w-9 rounded-lg lg:hidden icon-btn"
        @click="toggleMenu()"
        :aria-expanded="menu ? 'true' : 'false'"
        aria-controls="mobile-nav"
        aria-label="Toggle menu"
      >
        <i class="h-4 w-4 i-hugeicons-menu-01" x-show="!menu"></i>
        <i class="h-4 w-4 i-hugeicons-cancel-01" x-show="menu" style="display:none"></i>
      </button>
    </div>
  </div>

  <nav
    id="mobile-nav"
    class="border-t lg:hidden bd"
    style="background:var(--surface)"
    x-show="menu"
    x-cloak
    x-transition.opacity.duration.150ms
  >
    <div class="flex flex-col mx-auto px-4 py-2 sm:px-6 max-w-6xl">
      <a href="/features" data-no-router class="py-3 font-semibold border-b bd {{ navActive === 'features' ? 'accent' : '' }}" @click="menu = false">Features</a>
      <a href="/markets" data-no-router class="py-3 font-semibold border-b bd {{ navActive === 'markets' ? 'accent' : '' }}" @click="menu = false">Smart money</a>
      <a href="/scores/nfl/today" data-no-router class="py-3 font-semibold border-b bd {{ navActive === 'scores' ? 'accent' : '' }}" @click="menu = false">Scores</a>
      <a href="/community" data-no-router class="py-3 font-semibold border-b bd {{ navActive === 'community' ? 'accent' : '' }}" @click="menu = false">Community</a>
      <a href="/live" data-no-router class="py-3 font-semibold border-b bd {{ navActive === 'live' ? 'accent' : '' }}" @click="menu = false">Live</a>
      <a href="/" class="py-3 font-semibold border-b bd {{ navActive === 'board' ? 'accent' : '' }}" @click="menu = false">Odds</a>
      <a href="/pricing" data-no-router class="py-3 font-semibold {{ navActive === 'pricing' ? 'accent' : '' }}" @click="menu = false">Pricing</a>
      <a href="/pricing" data-no-router class="px-4 py-3 my-3 font-bold text-center rounded-lg sm:hidden btn btn-primary" @click="menu = false">Start</a>
    </div>
  </nav>
</header>
